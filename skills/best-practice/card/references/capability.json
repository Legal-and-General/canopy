  "intents": [
    {
      "confidence": "medium",
      "evidence": "skills/best-practice/card/SKILL.md:70",
      "statement": "**One fixed action:** place it directly in the footer. A button group adds nothing for a single action that is always shown."
    },
    {
      "confidence": "medium",
      "evidence": "skills/best-practice/card/SKILL.md:71",
      "statement": "**Two or more related actions:** wrap them in `lg-button-group`, with only one `primary`."
    },
    {
      "confidence": "medium",
      "evidence": "skills/best-practice/card/SKILL.md:72",
      "statement": "**An action that is sometimes joined by a second:** `lg-button-group` is acceptable, so the layout is the same whether or not the second action is shown."
    },
    {
      "confidence": "medium",
      "evidence": "skills/best-practice/card/SKILL.md:73",
      "statement": "Use `<button lg-button>` for an action on the page, and `<a lg-button>` with `routerLink` only when navigating to a route."
    },
    {
      "confidence": "medium",
      "evidence": "skills/best-practice/card/SKILL.md:107",
      "statement": "**Vertical** (default): hero image or pictogram sits at the **top** of the card."
    },
    {
      "confidence": "medium",
      "evidence": "skills/best-practice/card/SKILL.md:108",
      "statement": "**Horizontal**: in `LgCardComponent`, the hero image or pictogram is positioned on the **right** of the card body."
    },
    {
      "confidence": "high",
      "evidence": "skills/best-practice/card/SKILL.md:360",
      "statement": "ensure that content relates to a single idea or concept."
    },
    {
      "confidence": "high",
      "evidence": "skills/best-practice/card/SKILL.md:361",
      "statement": "summarise content and provide links to expanded content on child pages."
    },
    {
      "confidence": "high",
      "evidence": "skills/best-practice/card/SKILL.md:362",
      "statement": "use when each card will contain different types of content."
    },
    {
      "confidence": "high",
      "evidence": "skills/best-practice/card/SKILL.md:363",
      "statement": "place cards directly on the page background."
    },
    {
      "confidence": "high",
      "evidence": "skills/best-practice/card/SKILL.md:364",
      "statement": "create layouts that make the hierarchy of the page clearly understood."
    },
    {
      "confidence": "high",
      "evidence": "skills/best-practice/card/SKILL.md:365",
      "statement": "keep promotional message content succinct — follow content guidelines (title max 33 chars, description max 140 chars, link max 20 chars)."
    },
    {
      "confidence": "high",
      "evidence": "skills/best-practice/card/SKILL.md:366",
      "statement": "use the `interactive` card variant for navigation cards and prefer `LgCardNavigationTitleComponent` in `lg-card-header`."
    },
    {
